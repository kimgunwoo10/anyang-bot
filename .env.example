# Discord 봇 토큰 (Discord Developer Portal > Bot > Token)
DISCORD_TOKEN=your_discord_bot_token_here

# Google Gemini API 키 - 무료 발급 (https://aistudio.google.com/apikey)
GEMINI_API_KEY=your_gemini_api_key_here

# 사용할 Gemini 모델 (무료 티어에서 사용 가능한 기본값)
GEMINI_MODEL=gemini-2.5-flash

# Google Cloud Text-to-Speech API 키 - Standard A/B/C/D 목소리용
# (Google Cloud Console -> API 및 서비스 -> 사용자 인증 정보 -> API 키 생성, Text-to-Speech API 활성화 필요)
GOOGLE_TTS_API_KEY=

# ElevenLabs API 키 - 프리미엄 TTS 목소리용, 무료 플랜 있음 (https://elevenlabs.io -> Profile -> API keys)
# 비워두면 ElevenLabs 목소리는 비활성화됩니다.
ELEVENLABS_API_KEY=

# SQLite 데이터베이스 파일 경로 (기본값 그대로 사용해도 무방)
DB_PATH=data/anyang.db

# ---- 웹 레벨 상점 ----
# Discord 개발자 포털 > OAuth2 > Client Secret 값 (Reset Secret으로 발급)
DISCORD_CLIENT_SECRET=
# 개발자 포털 OAuth2 > Redirects에 아래 주소를 그대로 등록해야 로그인이 동작함
OAUTH_REDIRECT_URI=http://localhost:8080/callback
# 웹 상점 포트
WEB_PORT=8080
# 상점을 운영할 서버 ID (비워두면 이름에 "금단증상"이 들어간 서버를 자동으로 찾음)
SHOP_GUILD_ID=
